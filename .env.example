# ==============================================================================
# AegisMind Sovereign Local Agent Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# General settings
AEGISMIND_ENV=development
AEGISMIND_LOG_LEVEL=INFO
AEGISMIND_API_PORT=8000
AEGISMIND_API_HOST=0.0.0.0

# Local Ollama LLM and Embeddings
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Local Sovereign Sandboxing and Storage
LOCAL_ALLOWLIST_ROOTS=.
LOCAL_NOTES_DIR=./notes

# Candidate overfetching controls
RETRIEVAL_OVERFETCH_MIN_FACTOR=3.0
RETRIEVAL_OVERFETCH_MAX_FACTOR=5.0
RETRIEVAL_DEFAULT_OVERFETCH_FACTOR=4.0
RETRIEVAL_DEFAULT_TOP_K=5
